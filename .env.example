# Use: python scripts/generate_env.py --development
# Production: python scripts/generate_env.py --origin https://escala.suaempresa.com.br
# This file has no usable credentials. Never commit the generated .env.
ESCALA_MODE=saas
ESCALA_ENVIRONMENT=production
ESCALA_PUBLIC_ORIGIN=https://escala.suaempresa.com.br
ESCALA_ALLOWED_HOSTS=["escala.suaempresa.com.br","localhost","127.0.0.1"]
ESCALA_SECURE_COOKIES=true
